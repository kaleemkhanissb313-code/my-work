{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Basic to Advanced",
  "version": "0.1.0",
  "identifier": "app.basictoadvanced.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Basic to Advanced", "width": 1280, "height": 820, "minWidth": 360, "minHeight": 560, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": ["icons/icon.png"]
  }
}
