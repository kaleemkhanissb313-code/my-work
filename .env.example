# Copy to .env.local and fill in. Only PUBLIC (anon/publishable) values belong here —
# these are bundled into client code. Never put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Supabase Edge Function secrets, set with `supabase secrets set`):
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
